includes:
    - ./vendor/nunomaduro/larastan/extension.neon

parameters:
    paths:
        - app

    level: 5

    # Larastan 1.x sets checkGenericClassInNonGenericObjectType: false,
    # which is deprecated in PHPStan 1.11+. The codebase already carries
    # proper generic typehints, so enable the check explicitly.
    checkGenericClassInNonGenericObjectType: true
    checkMissingIterableValueType: true
    checkUninitializedProperties: true

    reportUnmatchedIgnoredErrors: true
